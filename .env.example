# Firebase (client) — demo project vvelt-portfolio-pos only. Never use production IDs.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vvelt-portfolio-pos
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Published demo password (showcase). Enables one-click login on LoginScreen.
NEXT_PUBLIC_DEMO_PASSWORD=

# Scripts (node) — optional; local only. Never commit service accounts.
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/serviceAccount.json
# FIREBASE_AUTH_EMAIL=demo@vvelt.xyz
# FIREBASE_AUTH_PASSWORD=
